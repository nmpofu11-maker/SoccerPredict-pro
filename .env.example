# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SPORTAPI_AI_KEY: Primary provider for automated daily fixture ingestion
# and results settlement (https://sportapi.ai). Covers 100+ global leagues,
# live scores, and match events.
SPORTAPI_AI_KEY=""

# THERUNDOWN_KEY: Secondary provider and betting odds feed (https://therundown.io).
# Delivers consensus sportsbook odds (DraftKings, FanDuel, BetMGM) and match
# coverage across major soccer leagues (EPL, La Liga, Serie A, Bundesliga, Ligue 1, MLS, UCL).
THERUNDOWN_KEY=""

# FOOTBALL_DATA_KEY: Authentic official league standings and recent form feed (https://www.football-data.org).
# Free API key providing official table ranks, points, and 5-match form sequences (W-D-L) across top competitions.
FOOTBALL_DATA_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"


# PitchAPI football fixtures/analytics API. Keep this server-side.
PITCHAPI_API_KEY=""

# SportDB API (https://dashboard.sportdb.dev). High-speed soccer data and fixtures feed.
SPORTDB_API_KEY=""
