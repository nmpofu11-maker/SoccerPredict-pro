ADMIN_API_KEY=
ALLOW_OPEN_ADMIN=
# Applying proposed historical training weights is opt-in; keep disabled unless you intend to persist them.
ALLOW_LEARNING_TRAINING=0
BSD_API_KEY=
API_FOOTBALL=
API_FOOTBALL_KEY=
API_FOOTBALL_USE_RAPIDAPI=
FOOTBALL_DATA_KEY=
GEMINI_API_KEY=
PITCHAPI_API_KEY=
SPORTAPI_AI_KEY=
SPORTDB_API_KEY=
SPORTMONKS_API_KEY=
THERUNDOWN_KEY=
# Runtime audit/settlement/training state. For durable Cloud Run history, use a persistent mounted volume.
# PREDICTION_LOG_PATH, RESULTS_LOG_PATH, CRON_STATUS_PATH and HISTORICAL_DATA_PATH default to files under ./data.
# Leave paths blank for local use, or set a complete file path (not just a directory) for mounted durable storage.
# If a path points to an existing directory, the app now resolves it to a safe data file path and logs a warning.
# LEARNING_STATE_PATH defaults to ./data/persisted_learning_state.json.
# LEARNING_BACKUP_DIR defaults to ./data/backups, or to a backups/ directory beside LEARNING_STATE_PATH if that path is customized.
# Any local ./data default may be ephemeral on serverless hosts; a configured path alone does not prove its volume is durable.
PREDICTION_LOG_PATH=
RESULTS_LOG_PATH=
CRON_STATUS_PATH=
HISTORICAL_DATA_PATH=
# Historical archive safety snapshots default to historical-backups/ beside the archive.
# Set HISTORICAL_BACKUP_DIR to a directory on persistent storage if needed.
HISTORICAL_BACKUP_DIR=
LEARNING_STATE_PATH=
LEARNING_BACKUP_DIR=
