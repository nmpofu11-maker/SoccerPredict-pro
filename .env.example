# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SPORTAPI_AI_KEY: Primary provider for automated daily fixture ingestion
# and results settlement (https://sportapi.ai). Covers 100+ global leagues,
# live scores, and match events. Feeds schedule and match settlement.
# Note: Does not supply per-team possession or shot averages (Rule 5 stays inactive).
SPORTAPI_AI_KEY=""

# THERUNDOWN_KEY: Secondary provider and betting odds feed (https://therundown.io).
# Delivers consensus sportsbook odds (DraftKings, FanDuel, BetMGM) and match
# coverage across major soccer leagues (EPL, La Liga, Serie A, Bundesliga, Ligue 1, MLS, UCL).
# Feeds fixture ingestion and consensus market odds; does not feed Rules 2, 3, 4, 5.
THERUNDOWN_KEY=""

# FOOTBALL_DATA_KEY: Authentic official league standings and recent form feed (https://www.football-data.org).
# Feeds Rule 2 (Position Gap Edge via /standings), Rule 3 (Recent Form via /matches),
# and Rule 4 (Head-to-Head when available). Without this key, Rules 2, 3, and 4 stay off
# (displaying "data unavailable") unless standings/form are supplied by another verified provider.
FOOTBALL_DATA_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PitchAPI football fixtures/analytics feed (https://pitchapi.com).
# Feeds tertiary fixture ingestion; does not provide possession/shot averages (Rule 5 stays inactive).
PITCHAPI_API_KEY=""

# SportDB API (https://dashboard.sportdb.dev). High-speed soccer data and fixtures feed.
# Feeds quaternary fixture ingestion; does not provide possession/shot averages (Rule 5 stays inactive).
SPORTDB_API_KEY=""

# API-Football via RapidAPI (server-side only). In Cloud Run, map this variable
# to Secret Manager secret API_FOOTBALL_USE_RAPIDAPI.
API_FOOTBALL_USE_RAPIDAPI=""

# Sportmonks v3 Football API (server-side only). In Cloud Run, map this variable
# to Secret Manager secret SPORTMONKS_API_KEY.
SPORTMONKS_API_KEY=""

# Optional provider base URL overrides (normally leave unset).
# API_FOOTBALL_BASE_URL="https://api-football-v1.p.rapidapi.com/v3"
# SPORTMONKS_BASE_URL="https://api.sportmonks.com/v3/football"

# ADMIN_API_KEY: Secret key required to access administrative endpoints (manual upload,
# fixture purge, learning state restore, and ad-hoc ingest). Sent via 'x-admin-api-key' header.
ADMIN_API_KEY=""

# ALLOW_OPEN_ADMIN: Development override flag (dev only). When set to "true" outside production,
# allows administrative access without configuring ADMIN_API_KEY. Fails closed in production.
ALLOW_OPEN_ADMIN="false"

