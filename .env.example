# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SOCCER_API_KEY: Your API-Football (api-sports.io) key. Powers the automated
# daily fixture ingestion job (05:00 server time) and the results-settlement
# job (every 3 hours) in server.ts. This is now used as a secondary provider
# if Sportmonks fails.
SOCCER_API_KEY=""

# SPORTMONKS_API_KEY: Your Sportmonks API token. Primary provider used for daily
# fixture ingestion and results settlement. Get your key at https://my.sportmonks.com/api/tokens
SPORTMONKS_API_KEY=""

# API_FOOTBALL_USE_RAPIDAPI: set to "true" only if your API-Football key is a
# RapidAPI subscription key rather than a direct api-sports.io key. Leave unset
# (or "false") for a direct api-sports.io key, which is the more common case.
API_FOOTBALL_USE_RAPIDAPI="false"

# SOCCER_API_MAX_DAILY_CALLS: optional override for the daily call budget the
# server enforces against your API-Football plan (defaults to 95, just under
# the typical 100/day free-tier cap, to leave headroom for manual/testing calls).
SOCCER_API_MAX_DAILY_CALLS="95"

# THESPORTSDB_API_KEY: fallback provider used automatically when API-Football
# is unavailable (not configured, suspended, quota exhausted, or erroring).
# Leave unset to use TheSportsDB's shared public test key "3" — this works,
# but is rate-limited and shared across every app using it. Get your own free
# key at https://www.thesportsdb.com/api.php for a private, more reliable
# quota. Note: TheSportsDB's free tier is for non-commercial use per their
# terms — check their current pricing page before relying on this in a
# monetized deployment.
THESPORTSDB_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

